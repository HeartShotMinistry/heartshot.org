---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';

const entry = await getEntry('pages', 'subscribe');
const { Content } = await render(entry!);
---

<BaseLayout title={entry!.data.title} description={entry!.data.description}>
  <section class="section container narrow">
    <div class="prose">
      <Content />
    </div>

    <p class="error-banner" role="alert" hidden id="subscribe-error"></p>

    <!--
      Posts to the /api/subscribe Worker route (worker/index.js), which calls the
      Mailchimp API server-side — see src/data wrangler.jsonc for the list ID and
      README for the MAILCHIMP_API_KEY secret setup. Field names/requiredness here
      match this list's actual merge fields (ADDRESS is a compound field requiring
      addr1/city/state/zip; FNAME/LNAME required; PHONE optional).
    -->
    <form action="/api/subscribe" method="post" class="card">
      <label for="EMAIL">Email Address *</label>
      <input type="email" name="EMAIL" id="EMAIL" required />

      <div class="row">
        <div>
          <label for="FNAME">First Name *</label>
          <input type="text" name="FNAME" id="FNAME" required />
        </div>
        <div>
          <label for="LNAME">Last Name *</label>
          <input type="text" name="LNAME" id="LNAME" required />
        </div>
      </div>

      <label for="ADDR1">Address — Mail-outs &amp; Tax Receipts *</label>
      <input type="text" name="ADDR1" id="ADDR1" placeholder="Street Address" required />
      <input type="text" name="ADDR2" placeholder="Address Line 2" />
      <div class="row row-3">
        <input type="text" name="CITY" placeholder="City" required />
        <input type="text" name="STATE" placeholder="State" required />
        <input type="text" name="ZIP" placeholder="Zip" required />
      </div>

      <label for="PHONE">Phone Number — Optional</label>
      <input type="tel" name="PHONE" id="PHONE" />

      <p class="required-note">* = required field</p>
      <button type="submit" class="btn">Subscribe</button>
    </form>
  </section>
</BaseLayout>

<style>
  .narrow { max-width: 32rem; }
  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .row-3 { grid-template-columns: 1fr 1fr 1fr; }
  .required-note {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }
  .error-banner {
    background: #fbeaea;
    color: var(--color-maroon-dark);
    border: 1px solid var(--color-maroon);
    border-radius: 0.5rem;
    padding: 0.75em 1em;
    font-weight: 600;
  }
  @media (max-width: 480px) {
    .row, .row-3 { grid-template-columns: 1fr; }
  }
</style>

<script>
  // Static site — the /api/subscribe Worker redirects back here with ?error=...
  // on failure, so the error state has to be read client-side, not at build time.
  const params = new URLSearchParams(location.search);
  const error = params.get('error');
  if (error) {
    const banner = document.getElementById('subscribe-error');
    if (banner) {
      banner.textContent =
        error === 'missing-fields'
          ? 'Please fill in all required fields.'
          : 'Something went wrong signing you up — please try again, or email us directly.';
      banner.hidden = false;
    }
  }
</script>
