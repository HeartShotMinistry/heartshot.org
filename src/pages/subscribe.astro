---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';
import { site } from '../data/site';

const entry = await getEntry('pages', 'subscribe');
const { Content } = await render(entry!);
---

<BaseLayout title={entry!.data.title} description={entry!.data.description}>
  <section class="section container narrow">
    <div class="prose">
      <Content />
    </div>

    <!--
      TODO(owner): This form currently points at a placeholder Mailchimp action URL
      (see src/data/site.ts -> forms.mailchimpAction). Replace it with your real
      embedded-form action + field names from Mailchimp: Audience -> Signup forms ->
      Embedded forms -> copy the generated <form> markup and swap it in here.
    -->
    <form action={site.forms.mailchimpAction} method="post" class="card" target="_blank">
      <label for="EMAIL">Email Address *</label>
      <input type="email" name="EMAIL" id="EMAIL" required />

      <div class="row">
        <div>
          <label for="FNAME">First Name *</label>
          <input type="text" name="FNAME" id="FNAME" required />
        </div>
        <div>
          <label for="LNAME">Last Name *</label>
          <input type="text" name="LNAME" id="LNAME" required />
        </div>
      </div>

      <label for="ADDR1">Address — Mail-outs &amp; Tax Receipts *</label>
      <input type="text" name="ADDR1" id="ADDR1" placeholder="Street Address" required />
      <input type="text" name="ADDR2" placeholder="Address Line 2" />
      <div class="row row-3">
        <input type="text" name="CITY" placeholder="City" />
        <input type="text" name="STATE" placeholder="State" />
        <input type="text" name="ZIP" placeholder="Zip / Postal" />
      </div>

      <label for="PHONE">Phone Number — Optional</label>
      <input type="tel" name="PHONE" id="PHONE" />

      <p class="required-note">* = required field</p>
      <button type="submit" class="btn">Subscribe</button>
    </form>
  </section>
</BaseLayout>

<style>
  .narrow { max-width: 32rem; }
  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .row-3 { grid-template-columns: 1fr 1fr 1fr; }
  .required-note {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }
  @media (max-width: 480px) {
    .row, .row-3 { grid-template-columns: 1fr; }
  }
</style>
