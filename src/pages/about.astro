---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';

const entry = await getEntry('pages', 'about');
const { Content } = await render(entry!);
---

<BaseLayout title={entry!.data.title} description={entry!.data.description}>
  <div class="banner">
    <img
      src="/images/gallery/range-with-logo.jpg"
      alt="Inside the Heart Shot Ministry archery range"
      width="1478"
      height="979"
    />
  </div>

  <section class="section container">
    <div class="prose page-prose">
      <Content />
    </div>
  </section>
</BaseLayout>

<style>
  .banner {
    width: 100%;
    height: 28rem;
    overflow: hidden;
  }
  .banner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Keeps the range + logo centered in the frame at this crop height. */
    object-position: center 58%;
    display: block;
  }
  .page-prose {
    max-width: 42rem;
    margin: 0 auto;
  }
  .page-prose blockquote {
    border-left: 3px solid var(--color-maroon);
    margin: 1.75em 0;
    padding: 0.25em 0 0.25em 1.25em;
    font-style: italic;
    color: var(--color-text-muted);
  }
  .page-prose blockquote footer {
    margin-top: 0.5em;
    font-style: normal;
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--color-maroon);
  }
</style>
