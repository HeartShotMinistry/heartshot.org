---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const events = (await getCollection('events', ({ data }) => data.published)).sort((a, b) =>
  a.data.title.localeCompare(b.data.title)
);
---

<BaseLayout title="Events" description="Upcoming Heart Shot Ministry events.">
  <section class="section container narrow">
    <h1>Events</h1>
    {events.length === 0 ? (
      <p>No events are open for registration right now — check back soon.</p>
    ) : (
      <ul class="event-list">
        {events.map((event) => (
          <li class="card">
            <a href={`/events/${event.id}/`}>
              <h3>{event.data.title}</h3>
              {event.data.summary && <p>{event.data.summary}</p>}
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>

<style>
  .narrow { max-width: 40rem; }
  .event-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .event-list a {
    text-decoration: none;
    color: inherit;
    display: block;
  }
  .event-list h3 { margin-bottom: 0.3em; }
  .event-list p {
    color: var(--color-text-muted);
    margin: 0;
  }
</style>
