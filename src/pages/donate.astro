---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';
import { site } from '../data/site';

const entry = await getEntry('pages', 'donate');
const { Content } = await render(entry!);
const { donate } = site;
---

<BaseLayout title={entry!.data.title} description={entry!.data.description}>
  <section class="section container">
    <div class="prose intro">
      <Content />
    </div>

    <div class="options">
      <div class="card option">
        <h3>Venmo</h3>
        <p>Quick, one-time or recurring gifts.</p>
        <a class="btn" href={donate.venmo} target="_blank" rel="noopener noreferrer">Give via Venmo</a>
      </div>

      <div class="card option">
        <h3>Operating Fund</h3>
        <p>Donate securely online via Donorbox.</p>
        <a class="btn" href={donate.donorbox} target="_blank" rel="noopener noreferrer">Donate Online</a>
      </div>

      <div class="card option">
        <h3>National Christian Foundation</h3>
        <p>Give non-cash assets like stock or a donor-advised fund.</p>
        <a class="btn btn-outline" href={donate.ncf} target="_blank" rel="noopener noreferrer">Give via NCF</a>
        <a class="link-line" href={donate.nonCashPdf}>Non-cash giving guide (PDF)</a>
        <a class="link-line" href={donate.ncfInfo} target="_blank" rel="noopener noreferrer">Learn more about non-cash giving</a>
      </div>

      <div class="card option">
        <h3>By Check</h3>
        <p>No online fees. Make checks payable to Heart Shot Ministry and mail to:</p>
        <address>
          {donate.mailAddress.map((line) => <span>{line}<br /></span>)}
        </address>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    max-width: 40rem;
    margin: 0 auto 2rem;
    text-align: center;
  }
  .options {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }
  .option h3 { margin-bottom: 0.4em; }
  .option p { color: var(--color-text-muted); }
  .link-line {
    display: block;
    margin-top: 0.75em;
    font-size: 0.9rem;
    font-weight: 600;
  }
  address {
    font-style: normal;
    color: var(--color-text-muted);
  }
  @media (max-width: 720px) {
    .options { grid-template-columns: 1fr; }
  }
</style>
