---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getEntry, getCollection, render } from "astro:content";
import { site } from "../data/site";

const entry = await getEntry("pages", "home");
const { Content } = await render(entry!);

// See content.config.ts — flipping `featured: true` on a published event
// promotes it here (and to a highlighted nav button in Header.astro).
const featuredEvent = (
  await getCollection("events", ({ data }) => data.published)
).find((event) => event.data.featured);
---

<BaseLayout title={entry!.data.title} description={entry!.data.description}>
  <div class="hero-bg" aria-hidden="true"></div>

  <section class="hero">
    <div class="container hero-inner">
      <img
        src="/images/logo/heart-shot-logo-full.png"
        alt={`${site.name} — ${site.tagline}`}
        class="hero-logo"
        width="640"
        height="395"
      />
      <div class="hero-actions">
        <a class="btn" href="/donate/">Donate</a>
        <a class="btn btn-outline" href="/contact/">Contact Us</a>
      </div>
    </div>
  </section>

  <section class="intro">
    <div class="container prose">
      <Content />
    </div>
  </section>

  {
    featuredEvent?.data.flyer && (
      <section class="featured-event">
        <div class="container">
          <a href={`/events/${featuredEvent.id}/`}>
            <img
              src={featuredEvent.data.flyer}
              alt={featuredEvent.data.title}
            />
          </a>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .hero-bg {
    position: fixed;
    inset: 0;
    z-index: -1;
    background: url("/images/gallery/arrows-blurred-background.jpg") center /
      cover no-repeat;
  }
  .hero-bg::after {
    content: "";
    position: absolute;
    inset: 0;
    /* Light scrim so the logo/buttons stay legible over a busy photo,
       while keeping the site's airy, light-background feel. */
    background: linear-gradient(
      180deg,
      rgba(250, 248, 245, 0.55),
      rgba(250, 248, 245, 0.85)
    );
  }
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 3rem 0 2.5rem;
    text-align: center;
  }
  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.75rem;
  }
  .hero-logo {
    width: min(420px, 90%);
    height: auto;
  }
  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .intro {
    position: relative;
    background: var(--color-bg);
    padding-top: 2.5rem;
    text-align: center;
  }
  .intro .prose {
    max-width: 42rem;
    margin: 0 auto;
  }
  .intro :global(h2) {
    margin: 0;
  }
  .featured-event {
    position: relative;
    background: var(--color-bg);
    padding-block: 2rem;
    text-align: center;
  }
  .featured-event img {
    max-width: min(420px, 90%);
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
</style>
