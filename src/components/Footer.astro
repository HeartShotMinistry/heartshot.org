---
import { site } from '../data/site';
import RangeInfo from './RangeInfo.astro';
---

<footer class="site-footer">
  <div class="container grid">
    <div class="about-col">
      <img src="/images/logo/heart-shot-mark.png" alt="" class="mark" width="52" height="52" />
      <p class="tagline">{site.tagline}</p>
      <a class="ig-link" href={site.instagram} target="_blank" rel="noopener noreferrer">
        Follow us on Instagram
      </a>
    </div>

    <RangeInfo />

    <nav class="links-col">
      <h3>Quick Links</h3>
      <ul>
        {site.nav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>

  <div class="container">
    <p class="fine-print">© {new Date().getFullYear()} {site.name}. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    margin-top: 4rem;
    padding-top: 3rem;
  }
  .grid {
    display: grid;
    grid-template-columns: 1.1fr 1.4fr 1fr;
    gap: 2.5rem;
    padding-bottom: 2rem;
  }
  .about-col .mark { border-radius: 999px; margin-bottom: 0.75rem; }
  .tagline {
    font-family: var(--font-display);
    color: var(--color-maroon);
    font-weight: 600;
  }
  .ig-link {
    display: inline-block;
    font-weight: 600;
    font-size: 0.9rem;
  }
  .links-col h3 {
    font-size: 1.1rem;
    margin-bottom: 0.75em;
  }
  .links-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5em;
  }
  .links-col a {
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
  }
  .fine-print {
    border-top: 1px solid var(--color-border);
    padding: 1.25rem 0;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  @media (max-width: 720px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
